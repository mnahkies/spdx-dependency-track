{
  "name": "spdx-dependency-track",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "husky",
    "dev": "pnpm run migrate && next dev",
    "package": "docker build -t spdx-dependency-track --progress=plain .",
    "start": "next start",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "biome lint --write .",
    "format": "biome check --write .",
    "docs:generate": "pnpm exec markdown-toc -i --bullets=- ./README.md",
    "migrate": "dotenvx run -- ./bin/migrate.sh",
    "migrate-generate": "dotenvx run -- ./bin/migrate-generate.sh",
    "migrate-rehash": "dotenvx run -- atlas migrate hash --dir 'file://migrations",
    "ci-build": "./bin/build.sh",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "ci-lint": "echo 'n/a'",
    "ci-format": "biome ci .",
    "ci-pipeline": "pnpm run ci-build && pnpm run ci-test && pnpm run format && pnpm run lint"
  },
  "dependencies": {
    "@ariga/atlas": "^0.33.1",
    "@dotenvx/dotenvx": "^1.44.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/material-nextjs": "^7.1.0",
    "@nahkies/typescript-fetch-runtime": "^0.20.0",
    "@nahkies/typescript-koa-runtime": "^0.20.0",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-query-devtools": "^5.76.1",
    "@tanstack/react-query-next-experimental": "^5.76.1",
    "better-sqlite3": "^11.10.0",
    "next": "15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "semver": "^7.7.2",
    "spdx-expression-parse": "^4.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nahkies/openapi-code-generator": "^0.20.0",
    "@swc/core": "^1.11.24",
    "@swc/jest": "^0.2.38",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/semver": "^7.7.0",
    "@types/spdx-expression-parse": "^3.0.5",
    "husky": "^9.1.7",
    "jest": "^30.0.0-alpha.6",
    "lint-staged": "^16.0.0",
    "markdown-toc": "^1.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "pnpm exec biome lint --write --no-errors-on-unmatched",
      "pnpm exec biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "sh -c 'pnpm run docs:generate'"
    ]
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
